# Focus Analytics — локальная конфигурация
# Скопируйте в .env и заполните значения. Не коммитьте реальные секреты.

# PostgreSQL (docker-compose подставляет host db автоматически для сервисов)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=focus_analytics
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/focus_analytics

# Bitrix24 (только read-only webhook). Оставьте пустым для работы без синхронизации.
BITRIX_WEBHOOK_URL=
BITRIX_PORTAL_URL=
BITRIX_CATEGORY_IDS=1,39

# Синхронизация
SYNC_INTERVAL_MINUTES=5
SYNC_OVERLAP_MINUTES=10
FULL_RECONCILE_HOURS=24

# Безопасность
SESSION_SECRET=replace-with-long-random-string
COOKIE_SECURE=false
# Include host-mapped frontend ports used by docker-compose (13000) and local (3000)
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000,http://localhost:3000,http://127.0.0.1:3000

# Приложение
APP_TIMEZONE=Europe/Moscow
DEMO_MODE=false

# Frontend rewrite target. Inside Docker Compose use http://backend:8000.
# For local Next.js without Docker: http://localhost:18000 (compose host map) or :8000
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_BITRIX_PORTAL_URL=
