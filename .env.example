# Focus Analytics — copy to .env and fill values.
# Never commit real secrets.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=focus_analytics
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/focus_analytics

# Bitrix24 (read-only webhook only)
BITRIX_WEBHOOK_URL=
BITRIX_PORTAL_URL=
BITRIX_CATEGORY_IDS=1,39

# Sync
SYNC_INTERVAL_MINUTES=5
SYNC_OVERLAP_MINUTES=10
FULL_RECONCILE_HOURS=24

# Security
SESSION_SECRET=change-me
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000,http://localhost:3000,http://127.0.0.1:3000

# App
APP_TIMEZONE=Europe/Moscow
DEMO_MODE=false

# Manager Control / Timeman (read-only)
TIMEMAN_COLLECTOR_ENABLED=true
TIMEMAN_MAX_MANAGERS_PER_CYCLE=50

# Frontend (Docker / local)
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_BITRIX_PORTAL_URL=

# Avito Business API (READ ONLY probe / future analytics). Secrets never committed.
# Support 4+ accounts via numbered slots; credentials stay in env/secret storage.
AVITO_ACCOUNT_1_NAME=
AVITO_ACCOUNT_1_CLIENT_ID=
AVITO_ACCOUNT_1_CLIENT_SECRET=
AVITO_ACCOUNT_1_ENABLED=true
# AVITO_ACCOUNT_2_NAME=
# AVITO_ACCOUNT_2_CLIENT_ID=
# AVITO_ACCOUNT_2_CLIENT_SECRET=
# Legacy single-account aliases (optional → slot 1):
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=
