# Copy to .env.production outside version control; replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME_USE_RANDOM_HEX_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+asyncpg://focus:CHANGE_ME_USE_RANDOM_HEX_AT_LEAST_32_CHARS@db:5432/focus_analytics
APP_ENV=production
COOKIE_SECURE=true
DEMO_MODE=false
CORS_ORIGINS=https://analytics.example.com
APP_TIMEZONE=Europe/Moscow
BITRIX_WEBHOOK_URL=
BITRIX_PORTAL_URL=
BITRIX_CATEGORY_IDS=1,39
# Directory must contain a valid fullchain.pem and privkey.pem for your domain.
TLS_CERT_DIR=/absolute/path/to/focus-tls
